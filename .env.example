# Copy to .env, fill in, then load it into your shell: set -a && source .env && set +a
# Not needed for `make demo` or the tests: they use fake models only.

# Provider keys (placeholders)
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Models used for a bare `-m anthropic` / `-m openai`, and the default judge
LJH_ANTHROPIC_MODEL=claude-sonnet-5-5
LJH_OPENAI_MODEL=gpt-6.1-sol
LJH_JUDGE_MODEL=anthropic:claude-sonnet-5-5

# Reliability: per-call timeout, retries on 429/5xx, client-side limits per provider
LJH_TIMEOUT_S=60
LJH_MAX_RETRIES=4
LJH_MAX_CONCURRENCY=8
LJH_RPM=60
LJH_MAX_TOKENS=16000

# Response cache and optional price overrides
LJH_CACHE_PATH=.ljh_cache.sqlite
# LJH_PRICES_FILE=prices.yaml
